{
  "id": "org.minimal.home",
  "version": "1.4.2",
  "vendor": "local",
  "title": "Minimal Home",
  "icon": "icon.png",
  "main": "index.html",
  "type": "web",
  "appDescription": "Minimal ad-free launcher: apps and inputs only",
  "iconColor": "#0b0e14",
  "visible": true,
  "noSplashOnLaunch": true,
  "disableBackHistoryAPI": true,
  "keepAlive": true,
  "closeOnBackground": false,
  "requiredPermissions": [
    "public",
    "applications",
    "applications.launch",
    "applications.query",
    "applications.internal"
  ],
  "requiredACG": [
    "application.launcher",
    "application.query"
  ]
}
